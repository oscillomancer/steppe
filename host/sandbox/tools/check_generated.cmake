# Compares the sandbox's (or the engine's) generator output with the files
# committed under skill/generated/. Regenerate with tools/gen/update-generated.sh.
if(NOT DEFINED PREFIX)
  set(PREFIX sandbox)
endif()
foreach(pair "--mcp-tools;${PREFIX}-mcp-tools.json" "--lua;${PREFIX}.lua")
  list(GET pair 0 flag)
  list(GET pair 1 file)
  execute_process(COMMAND ${TOOL} registry ${flag} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${TOOL} registry ${flag} failed (${rc})")
  endif()
  file(READ ${GENERATED}/${file} committed)
  if(NOT out STREQUAL committed)
    message(FATAL_ERROR "skill/generated/${file} is out of date: run tools/gen/update-generated.sh")
  endif()
endforeach()
# The command reference is one file per command group plus an index, in <prefix>/.
set(_fresh ${CMAKE_CURRENT_BINARY_DIR}/check-generated-${PREFIX})
file(REMOVE_RECURSE ${_fresh})
execute_process(COMMAND ${TOOL} registry --markdown-dir ${_fresh} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${TOOL} registry --markdown-dir failed (${rc})")
endif()
file(GLOB _made RELATIVE ${_fresh} ${_fresh}/*)
file(GLOB _kept RELATIVE ${GENERATED}/${PREFIX} ${GENERATED}/${PREFIX}/*)
list(SORT _made)
list(SORT _kept)
if(NOT _made STREQUAL _kept)
  message(FATAL_ERROR "skill/generated/${PREFIX}/ lists different files than the registry makes (a group added, removed or renamed?): run tools/gen/update-generated.sh")
endif()
foreach(file IN LISTS _made)
  file(READ ${_fresh}/${file} out)
  file(READ ${GENERATED}/${PREFIX}/${file} committed)
  if(NOT out STREQUAL committed)
    message(FATAL_ERROR "skill/generated/${PREFIX}/${file} is out of date: run tools/gen/update-generated.sh")
  endif()
endforeach()
file(REMOVE_RECURSE ${_fresh})
# The engine's also prints the built-in rack modules (rack-modules.md).
if(PREFIX STREQUAL "engine")
  execute_process(COMMAND ${TOOL} modules --markdown OUTPUT_VARIABLE out RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${TOOL} modules --markdown failed (${rc})")
  endif()
  file(READ ${GENERATED}/rack-modules.md committed)
  if(NOT out STREQUAL committed)
    message(FATAL_ERROR "skill/generated/rack-modules.md is out of date: run tools/gen/update-generated.sh")
  endif()
endif()
